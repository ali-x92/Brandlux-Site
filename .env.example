# Supabase (publishable/anon key is safe to expose; never commit the service role key)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-only, never expose to the client (used by client.server.ts if you add admin server functions)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Outbound email is NOT configured here. RESEND_API_KEY / WEBHOOK_SECRET / MAIL_FROM are
# Supabase Edge Function secrets (see README "Email: receiving, and the auto-replies").
